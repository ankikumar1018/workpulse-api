# These variable names must match the fields declared in core/config.py::Settings.
# App
APP_NAME=WorkPulse API
APP_VERSION=0.1.0
DEBUG=False

# Database (used to build core.config.Settings.DATABASE_URL)
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=workpulse
SQL_ECHO=False

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated list, or a single * for all origins in local development)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# WhatsApp Integration (optional for MVP, not yet read by Settings)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Google Cloud (for production)
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Email (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# External APIs
EXTERNAL_API_TIMEOUT=30
EXTERNAL_API_RETRIES=3
